- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\nimport pmt\nfrom scipy\
      \ import signal\nimport time\n\nclass rm_gfsk_receiver(gr.basic_block):\n  \
      \  \"\"\"\n    RoboMaster 2-GFSK \u7EC8\u6781\u9AD8\u7CBE\u5EA6\u89E3\u8C03\u5668\
      \ (\u52A0\u5165\u6781\u6027\u4E92\u76F8\u5173\uFF0C\u514D\u75AB\u632F\u5E45\u5267\
      \u53D8)\n    \u5E26\u6709\u79D2\u7EA7\u6027\u80FD\u76D1\u63A7 (Windows \u53CB\
      \u597D\u578B)\n    \u4F5C\u4E3A\u6700\u540E\u4E00\u4E2A\u8282\u70B9 (Sink Block)\
      \ \u8FD0\u884C\n    \"\"\"\n    \n    def __init__(self, threshold=2400.0, sps=52,\
      \ packet_bytes=27):\n        gr.basic_block.__init__(\n            self,\n \
      \           name=\"RM GFSK Receiver Sink\",\n            in_sig=[np.float32],\n\
      \            out_sig=[np.uint8]\n        )\n        self.threshold = threshold\n\
      \        self.sps = sps\n        self.packet_bytes = packet_bytes\n        self.packet_bits\
      \ = packet_bytes * 8\n        self.payload_samples = self.packet_bits * self.sps\n\
      \n        access_code_hex = 0x2F6F4C74B914492E\n        bits = format(access_code_hex,\
      \ '064b')\n        symbols = np.array([1.0 if b == '1' else -1.0 for b in bits],\
      \ dtype=np.float32)\n        self.kernel = np.repeat(symbols, self.sps)\n  \
      \      self.kernel_len = len(self.kernel) \n\n        self.buf = np.array([],\
      \ dtype=np.float32)\n        self.state = \"SEARCH\"\n        \n        self.rx_count\
      \ = 0              # \u5386\u53F2\u603B\u8BA1\u5B8C\u7F8E\u5305\u6570\n    \
      \    self.last_print_time = time.time()  # \u4E0A\u6B21\u6253\u5370\u7684\u65F6\
      \u95F4\u6233\n        self.success_this_sec = 0      # \u8FD9\u4E00\u79D2\u5185\
      \u7684\u6210\u529F\u6B21\u6570\n        self.bad_header_this_sec = 0   # \u8FD9\
      \u4E00\u79D2\u5185\u7684\u574F\u5934\u6B21\u6570\n        self.bad_packet_print_counter\
      \ = 0 #\u574F\u5934\u6253\u5370\u63A7\u5236\n        \n        self.max_buf_size\
      \ = self.payload_samples * 5 \n\n    def general_work(self, input_items, output_items):\n\
      \        in0 = input_items[0]\n        out = output_items[0]\n\n        if len(in0)\
      \ == 0:\n            return 0\n\n        self.buf = np.concatenate((self.buf,\
      \ in0))\n        self.consume(0, len(in0))\n        produced = 0\n\n       \
      \ if len(self.buf) > self.max_buf_size:\n            self.buf = self.buf[-self.max_buf_size:]\n\
      \n        while True:\n            if self.state == \"SEARCH\":\n          \
      \      if len(self.buf) < self.kernel_len*5:\n                    break\n  \
      \              \n                # dc_trend = signal.lfilter([1 - 0.95], [1,\
      \ -0.95], self.buf)\n                centered_buf = self.buf - np.mean(self.buf)\n\
      \                sign_buf = np.sign(centered_buf)\n                sign_buf[sign_buf\
      \ == 0] = 1.0\n                \n                corr = signal.correlate(sign_buf,\
      \ self.kernel, mode='valid', method='fft')\n                peaks, _ = signal.find_peaks(corr,\
      \ height=self.threshold, distance=self.sps*8)\n\n                if len(peaks)\
      \ > 0:\n                    peak_idx = peaks[0]\n                    self.state\
      \ = \"EXTRACT\"\n                    self.buf = self.buf[peak_idx:]\n      \
      \          else:\n                    self.buf = self.buf[-(self.kernel_len\
      \ - 1):]\n                    break\n\n            elif self.state == \"EXTRACT\"\
      :\n                if len(self.buf) >= self.payload_samples:\n\n           \
      \         packet_wave = self.buf[:self.payload_samples]\n                  \
      \  self.buf = self.buf[self.payload_samples:]\n\n                    #\u52A8\
      \u6001\u5339\u914D\u6CE2\u5F62\u4E2D\u5FC3\u90E8\u5206\uFF0C\u51CF\u5C11\u632F\
      \u5E45\u5267\u53D8\u7684\u5F71\u54CD\n                    preamble_wave = packet_wave[:64\
      \ * self.sps]\n                    high_level = np.percentile(preamble_wave,\
      \ 90)\n                    low_level = np.percentile(preamble_wave, 10)\n\n\
      \                    symbols_matrix = packet_wave.reshape(-1, self.sps)\n  \
      \                  start_idx = self.sps // 2 - 2\n                    end_idx\
      \ = self.sps  // 2 + 2\n                    symbol_voltages = np.mean(symbols_matrix[:,\
      \ start_idx:end_idx], axis=1)\n\n                    bits = np.zeros(len(symbol_voltages),\
      \ dtype=np.uint8)\n                    # alpha = 0.1\n                    \n\
      \                    for i, v in enumerate(symbol_voltages):\n             \
      \           threshold = (high_level + low_level) / 2.0\n                   \
      \     if v > threshold:\n                            bits[i] = 1\n         \
      \                   # high_level = (1 - alpha) * high_level + alpha * v\n  \
      \                      else:\n                            bits[i] = 0\n    \
      \                        # low_level = (1 - alpha) * low_level + alpha * v\n\
      \n                    byte_array = np.packbits(bits)\n\n                   \
      \ \n                    # \u6210\u529F\u548C\u5931\u8D25\u7684\u8BA1\u6570\u903B\
      \u8F91\n                    if byte_array[0] == 0x2F and byte_array[1] == 0x6F:\n\
      \                        self.rx_count += 1\n                        self.success_this_sec\
      \ += 1 # \u6210\u529F\u8BA1\u6570\u5668 +1\n                        #print(f\"\
      [{time.strftime('%H:%M:%S')}] \U0001F4E6 \u5B8C\u7F8E\u5305 #{self.rx_count}\
      \ | {hex_str}\")\n\n                        # \u6838\u5FC3\u4FEE\u6539\uFF1A\
      \u5207\u7247\u83B7\u53D6\u540E 15 \u4E2A\u5B57\u8282 (\u5047\u8BBE\u603B\u957F\
      \ 27\uFF0C12:27 \u5C31\u662F\u540E 15 \u4E2A)\n                        payload\
      \ = byte_array[-15:] \n                        payload_len = len(payload) #\
      \ \u8FD9\u91CC\u662F 15\n\n                        # \u628A\u8FD9\u7EAF\u51C0\
      \u7684 15 \u4E2A\u5B57\u8282\u8F93\u51FA\u7ED9 downstream \u7684 ZMQ\n     \
      \                   out[produced : produced + payload_len] = payload\n     \
      \                   tag_index = self.nitems_written(0) + produced\n        \
      \                self.add_item_tag(0, tag_index, pmt.intern(\"packet_len\"),\
      \ pmt.from_long(payload_len))\n                        produced += payload_len\n\
      \                        \n                    else:\n                     \
      \   self.bad_header_this_sec += 1 # \u8BEF\u7801\u8BA1\u6570\u5668 +1\n    \
      \                    self.bad_packet_print_counter += 1 \n                 \
      \       \n                        # \u3010\u4FEE\u6539\u70B9\u3011\u6EE1 10\
      \ \u4E2A\u574F\u5305\u65F6\uFF0C\u628A\u5305\u7684\u5185\u5BB9\u8F6C\u6210 16\
      \ \u8FDB\u5236\u6253\u5370\u51FA\u6765\n                        if self.bad_packet_print_counter\
      \ >= 10:\n                            # \u5C06 byte_array \u8F6C\u6362\u4E3A\
      \u4F8B\u5982 \"2F 6E 4C ...\" \u7684\u683C\u5F0F\n                         \
      \   hex_data = ' '.join([f'{b:02X}' for b in byte_array])\n                \
      \            print(f\"[{time.strftime('%H:%M:%S')}] \u26A0\uFE0F \u7B2C 10 \u4E2A\
      \u574F\u5305\u5185\u5BB9: {hex_data}\")\n                            self.bad_packet_print_counter\
      \ = 0\n\n                    self.state = \"SEARCH\"\n                else:\n\
      \                    break\n        \n        current_time = time.time()\n \
      \       if current_time - self.last_print_time >= 1.0:\n            print(f\"\
      [{time.strftime('%H:%M:%S')}] \u6027\u80FD\u76D1\u63A7 | \u6210\u529F: {self.success_this_sec}\
      \ \u5305/\u79D2 | \u4E22\u5F03(\u5047\u5CF0/\u574F\u5934): {self.bad_header_this_sec}\
      \ \u6B21/\u79D2 | \u603B\u63A5\u6536: {self.rx_count}\")\n            \n   \
      \         self.success_this_sec = 0\n            self.bad_header_this_sec =\
      \ 0\n            self.last_print_time = current_time\n\n        return produced\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    packet_bytes: '27'
    sps: '52'
    threshold: '1500'
  states:
    _io_cache: "('RM GFSK Receiver Sink', 'rm_gfsk_receiver', [('threshold', '2400.0'),\
      \ ('sps', '52'), ('packet_bytes', '27')], [('0', 'float', 1)], [('0', 'byte',\
      \ 1)], '\\n    RoboMaster 2-GFSK \u7EC8\u6781\u9AD8\u7CBE\u5EA6\u89E3\u8C03\u5668\
      \ (\u52A0\u5165\u6781\u6027\u4E92\u76F8\u5173\uFF0C\u514D\u75AB\u632F\u5E45\u5267\
      \u53D8)\\n    \u5E26\u6709\u79D2\u7EA7\u6027\u80FD\u76D1\u63A7 (Windows \u53CB\
      \u597D\u578B)\\n    \u4F5C\u4E3A\u6700\u540E\u4E00\u4E2A\u8282\u70B9 (Sink Block)\
      \ \u8FD0\u884C\\n    ', ['packet_bytes', 'sps', 'threshold'])"
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1416, 472.0]
    rotation: 0
    state: disabled
- name: epy_block_1
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\nfrom scipy import\
      \ signal\n\nclass rm_gfsk_score_monitor(gr.sync_block):\n    \"\"\"\n    RoboMaster\
      \ 2-GFSK \u76F8\u5173\u6027\u6253\u5206\u76D1\u89C6\u5668 (\u8F93\u51FA\u8FDE\
      \u7EED\u7684\u5339\u914D\u6CE2\u5F62)\n    \"\"\"\n    def __init__(self, sps=52):\n\
      \        gr.sync_block.__init__(\n            self,\n            name=\"RM GFSK\
      \ Score Monitor\",\n            in_sig=[np.float32],\n            out_sig=[np.float32]\
      \ # \u8F93\u51FA\u8FDE\u7EED\u7684 Float32 \u6CE2\u5F62\n        )\n       \
      \ self.sps = sps\n        \n        # \u751F\u6210 Access Code \u7406\u60F3\u6CE2\
      \u5F62\n        access_code_hex = 0x2F6F4C74B914492E\n        bits = format(access_code_hex,\
      \ '064b')\n        symbols = np.array([1.0 if b == '1' else -1.0 for b in bits],\
      \ dtype=np.float32)\n        self.kernel = np.repeat(symbols, self.sps)\n  \
      \      self.kernel_len = len(self.kernel)\n        \n        # \u8BA9\u5E95\u5C42\
      \u7684 C++ \u5E2E\u6211\u4EEC\u5B8C\u7F8E\u7BA1\u7406\u6ED1\u52A8\u7A97\u53E3\
      \n        self.set_history(self.kernel_len)\n\n    def work(self, input_items,\
      \ output_items):\n        in0 = input_items[0]\n        out = output_items[0]\n\
      \        \n        # --- \u589E\u52A0\uFF1A\u548C\u63A5\u6536\u7AEF\u4E00\u6A21\
      \u4E00\u6837\u7684\u9884\u5904\u7406\u903B\u8F91 ---\n        # 1. \u52A8\u6001\
      \u53BB\u76F4\u6D41\n        centered_in0 = in0 - np.mean(in0)\n        \n  \
      \      # 2. \u6781\u6027\u4E8C\u503C\u5316 (\u5F3A\u5236\u538B\u5E73\u4E3A +1\
      \ \u548C -1)\n        sign_in0 = np.sign(centered_in0)\n        sign_in0[sign_in0\
      \ == 0] = 1.0\n        \n        # 3. \u4F7F\u7528\u4E8C\u503C\u5316\u540E\u7684\
      \u6CE2\u5F62\u7B97\u5F97\u5206\n        corr = signal.correlate(sign_in0, self.kernel,\
      \ mode='valid', method='fft')\n        \n        out[:] = corr\n        return\
      \ len(out)\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    sps: sps
  states:
    _io_cache: "('RM GFSK Score Monitor', 'rm_gfsk_score_monitor', [('sps', '52')],\
      \ [('0', 'float', 1)], [('0', 'float', 1)], '\\n    RoboMaster 2-GFSK \u76F8\
      \u5173\u6027\u6253\u5206\u76D1\u89C6\u5668 (\u8F93\u51FA\u8FDE\u7EED\u7684\u5339\
      \u914D\u6CE2\u5F62)\\n    ', ['sps'])"
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1392, 88.0]
    rotation: 0
    state: disabled
